# ============================================
# 知智 KnowHub 环境变量配置
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================

# [必填] 阿里云 DashScope API Key
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# [必填] Tavily Search API Key（联网搜索功能）
# 获取地址：https://tavily.com/
TAVILY_API_KEY=

# [必填] JWT 密钥（必须设置！否则每次重启用户需要重新登录）
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# [可选] 跨域配置（多个地址用逗号分隔）
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost

# [可选] HuggingFace 镜像加速（国内用户建议设置）
HF_ENDPOINT=https://hf-mirror.com

# [可选] 数据库目录
DB_DIR=./data

# [可选] SQLite 忙等待超时（毫秒）
SQLITE_BUSY_TIMEOUT=5000

# [可选] Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# [可选] SMTP 邮件配置（订阅推送功能）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
