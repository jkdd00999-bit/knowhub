# ==================== 知智 KnowHub 环境变量配置 ====================
# 复制此文件为 .env 并填写实际值

# ==================== 必填配置 ====================
# 阿里云 DashScope API Key（用于 Qwen LLM 和 Embedding）
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Tavily Search API Key（用于联网搜索）
# 获取地址：https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ==================== JWT 配置（必填！）====================
# ⚠️ 必须修改为随机字符串！留空时系统会自动生成临时密钥（重启后所有用户需重新登录）
# 不设置持久密钥 = 任何人都能伪造登录凭证
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ==================== Redis 配置（可选）====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== 数据库配置（可选）====================
# SQLite 数据库文件存储目录（默认 ./data，Docker 中为 /app/data）
# DB_DIR=./data
# SQLite 并发等待超时（毫秒，默认 5000）
# SQLITE_BUSY_TIMEOUT=5000

# ==================== CORS 跨域配置（生产部署必填）====================
# 逗号分隔，允许访问后端的前端地址
# 本地开发默认即可；生产部署请改为实际域名，如 https://yourdomain.com
# CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost

# ==================== 邮件推送配置（可选）====================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=your_email@example.com

# ==================== HuggingFace 镜像（国内部署建议设置）====================
# 重排模型首次启动自动从 HuggingFace 下载（约 2.2GB），国内访问较慢
# 设置国内镜像加速下载：
# HF_ENDPOINT=https://hf-mirror.com
